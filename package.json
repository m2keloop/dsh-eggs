  "private": true,
  "type": "module",
  "main": "src/integration/host.js",
  "exports": {
    ".": "./src/integration/host.js",
    "./package.json": "./package.json",
    "./remote-host": "./src/integration/remote-host.js",
    "./typert": "./src/integration/typert.js",
    "./client": "./src/client/client.js",
    "./tools": "./src/integration/tools.js",
    "./runner-scope": "./src/integration/runner-scope.js"
  },
  "files": [
    "src",
    "examples",
    "tests/adapter-example.test.js",
    "tests/support/adapter-harness.js",
    "cordis.patch.yml",
    "docs/technical-design.md",
    "docs/p0-validation.md",
